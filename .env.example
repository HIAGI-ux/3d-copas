# ==============================================
# VARIABLES DE ENTORNO — 3D Copas
# ==============================================
# Copiá este archivo, renombralo a ".env.local"
# y completá los valores con los de tu proyecto en Supabase.
#
# ¿DÓNDE SACAR ESTAS CLAVES?
# 1. Entrá a https://supabase.com y creá una cuenta gratis.
# 2. Hacé clic en "New Project", elegí nombre y contraseña.
# 3. Esperá 1 o 2 minutos a que termine de crearse.
# 4. En el menú izquierdo andá a Settings → API y copiá:

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project API keys → anon / public (es segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tu número de WhatsApp con código de país (sin +, sin espacios ni guiones)
# Ejemplo Balcarce: 5492266123456
NEXT_PUBLIC_WHATSAPP_NUMBER=5492266000000

# URL pública del sitio (en local dejalo así; en Vercel poné tu dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
